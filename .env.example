# ── Ma'lumotlar bazasi ───────────────────────────────────────────────────
POSTGRES_DB=jetar
POSTGRES_USER=jetar
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

REDIS_PORT=6379

# ── MinIO (rasm saqlash; MVP local diskda ishlaydi) ──────────────────────
MINIO_USER=jetar
MINIO_PASSWORD=change_me_minio_secret

# ── Xavfsizlik ───────────────────────────────────────────────────────────
# MAJBURIY. Kamida 32 belgi. Yaratish: openssl rand -base64 48
JWT_SECRET=

# ── Portlar ──────────────────────────────────────────────────────────────
API_PORT=5080
WEB_PORT=5173

# ── Frontend ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Bo'sh qoldiring => frontend nisbiy "/api" ishlatadi (bir domen, HTTPS uchun qulay).
PUBLIC_API_URL=

# ── Domen + HTTPS (Caddy) ────────────────────────────────────────────────
# Azure bepul DNS nomi yoki o'z domeningiz. Caddy shu domenga avtomatik
# Let's Encrypt sertifikat oladi.
DOMAIN=jetar.swedencentral.cloudapp.azure.com
LETSENCRYPT_EMAIL=admin@jetar.uz

# ── Ma'lumotlar bazasi rejimi ────────────────────────────────────────────
# Prodda demo ma'lumot yuklamang. Migratsiyalar avtomatik qo'llanadi.
DB_SEED=false
DB_AUTOMIGRATE=true

# ── Boshlang'ich admin akkaunti (MAJBURIY: ADMIN_PASSWORD) ────────────────
# Har ishga tushishda tekshiriladi: yo'q bo'lsa yaratiladi, bor bo'lsa Admin qilinadi.
# Login: telefon (yoki username) + shu parol. Kirgach parolni almashtiring.
ADMIN_FIRST_NAME=Samandar
ADMIN_LAST_NAME=Mamasoatov
ADMIN_USERNAME=samandar
ADMIN_PHONE=+998937650083
ADMIN_EMAIL=samandar@jetar.uz
ADMIN_PASSWORD=
# true qilsangiz har ishga tushishda admin paroli ADMIN_PASSWORD ga tiklanadi
# (parolni unutganda). Odatda false qoldiring.
ADMIN_FORCE_PASSWORD=false

# ── Pullik ko'tarish (TOP) ───────────────────────────────────────────────
BOOST_CARD_NUMBER=8600 0000 0000 0000
BOOST_CARD_HOLDER=JETAR

# ── Yangi model ──────────────────────────────────────────────────────────
# Escrow o'chirilgan — platforma to'lovga aralashmaydi. Yoqmang (litsenziya kerak).
ESCROW_ENABLED=false

# ── Telegram bildirishnomalar ────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# ── Muhit ────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
