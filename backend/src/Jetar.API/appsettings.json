{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=jetar;Username=jetar;Password=jetar",
    "Redis": ""
  },

  "Database": {
    "AutoMigrate": true,
    "Seed": true,
    "DetailedErrors": false
  },

  "Jwt": {
    "Issuer": "jetar",
    "Audience": "jetar-clients",
    "Secret": "CHANGE_ME_super_secret_key_at_least_32_chars_long",
    "AccessTokenMinutes": 120,
    "RefreshTokenDays": 30
  },

  "Platform": {
    "CommissionRate": 0.08,
    "AutoReleaseHours": 72,
    "UnpaidTransactionTimeoutMinutes": 60,
    "MinListingPrice": 10000,
    "MaxListingPrice": 100000000,
    "MaxImagesPerListing": 8,
    "MaxImageBytes": 5242880,
    "AutoApproveListings": true
  },

  "Payments": {
    "SandboxMode": true,
    "ReturnUrl": "http://localhost:5173/checkout/result",
    "Click":   { "Enabled": true, "MerchantId": "", "SecretKey": "", "BaseUrl": "" },
    "Payme":   { "Enabled": true, "MerchantId": "", "SecretKey": "", "BaseUrl": "" },
    "Uzum":    { "Enabled": true, "MerchantId": "", "SecretKey": "", "BaseUrl": "" },
    "Apelsin": { "Enabled": true, "MerchantId": "", "SecretKey": "", "BaseUrl": "" }
  },

  "Storage": {
    "Provider": "local",
    "LocalRoot": "wwwroot/uploads",
    "PublicBaseUrl": "/uploads"
  },

  "Telegram": {
    "Enabled": false,
    "BotToken": ""
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:4173" ]
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },

  "AllowedHosts": "*"
}
