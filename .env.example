# ── Ma'lumotlar bazasi ───────────────────────────────────────────────────
POSTGRES_DB=jetar
POSTGRES_USER=jetar
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

REDIS_PORT=6379

# ── MinIO (rasm saqlash; MVP local diskda ishlaydi) ──────────────────────
MINIO_USER=jetar
MINIO_PASSWORD=change_me_minio_secret

# ── Xavfsizlik ───────────────────────────────────────────────────────────
# MAJBURIY. Kamida 32 belgi. Yaratish: openssl rand -base64 48
JWT_SECRET=

# ── Portlar ──────────────────────────────────────────────────────────────
API_PORT=5080
WEB_PORT=5173

# ── Frontend ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5080

# ── Platforma qoidalari ──────────────────────────────────────────────────
COMMISSION_RATE=0.08
AUTO_RELEASE_HOURS=72

# ── To'lov provayderlari ─────────────────────────────────────────────────
# true bo'lsa haqiqiy pul harakati bo'lmaydi, to'lovlar sandboxda tasdiqlanadi.
PAYMENTS_SANDBOX=true
# true bo'lsa checkout Click/Payme/Uzum sahifasiga yo'naltiradi (sandbox bo'lsa ham).
# Merchant ID kalitlari qo'yilgach shu yo'l bilan jonli to'lov ishlaydi — kod o'zgarmaydi.
PAYMENTS_PROVIDER_REDIRECT=true
PAYMENT_RETURN_URL=http://localhost:5173/checkout/result

CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# ── Telegram bildirishnomalar ────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

# ── Muhit ────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
